{
    "manifest_version": 3,
    "name": "Stellr",
    "version": "1.0",
    "description": "Google Chrome extension for Stellr.",
    "side_panel": {
        "default_title": "stellr",
        "default_path": "side_panel.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        },
        "default_panel": "side_panel.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "permissions": [
        "activeTab",
        "scripting",
        "sidePanel"
    ],
    "host_permissions": [
        "http://127.0.0.1:8000/*",
        "https://*/*"
    ],
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}