{
    "manifest_version": 3,
    "name": "Float Extension",
    "version": "1.0",
    "description": "Google Chrome extension for Float.",
    "action": {
        "default_popup": "popup.html"
    },
    "permissions": [
        "activeTab"
    ],
    "host_permissions": [
        "http://127.0.0.1:8000/api/*"
    ]
}