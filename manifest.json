{
    "manifest_version": 3,
    "name": "stllr - dev",
    "version": "1.0",
    "description": "The Universal Forum - Dev",
    "side_panel": {
        "default_title": "stllr",
        "default_path": "panel.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        },
        "default_panel": "panel.html"
    },
    "action": {
        "default_title": "stllr"
    },
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "permissions": [
        "activeTab",
        "scripting",
        "sidePanel",
        "storage"
    ],
    "host_permissions": [
        "http://127.0.0.1:8000/*",
        "https://stllr.io/*"
    ],
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}